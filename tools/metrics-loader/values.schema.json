{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "pullPolicy"]
    },
    "job": {
      "type": "object",
      "properties": {
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": ["integer", "null"], "minimum": 0 },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["backoffLimit", "annotations"]
    },
    "basicAuth": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "usernameKey": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[-._a-zA-Z0-9]+$"
        },
        "passwordKey": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[-._a-zA-Z0-9]+$"
        }
      },
      "required": ["existingSecret", "usernameKey", "passwordKey"]
    },
    "sampleLoader": {
      "type": "object",
      "properties": {
        "config": { "type": "string", "minLength": 1 },
        "remoteWriteUrl": { "type": "string" },
        "remoteWriteVersion": { "type": "string", "enum": ["v1", "v2"] },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "interval": { "type": "string", "minLength": 1 },
        "maxSamples": { "type": "integer", "minimum": 1 },
        "tickInterval": { "type": "string", "minLength": 1 },
        "workers": { "type": "integer", "minimum": 1 },
        "replicaFromJobCompletionIndex": { "type": "boolean" },
        "replica": { "type": "integer" },
        "infinite": { "type": "boolean" },
        "duration": {
          "type": "string",
          "pattern": "^$|^[1-9][0-9]{0,5}(ns|us|ms|s|m|h)$"
        },
        "tablePickCount": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
        "dryRun": { "type": "boolean" },
        "churnRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "churnInterval": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "enum": ["prometheus", "otlp"] }
      },
      "required": [
        "config", "remoteWriteUrl", "remoteWriteVersion", "username", "password",
        "startDate", "endDate", "interval",
        "maxSamples", "tickInterval", "workers",
        "replicaFromJobCompletionIndex", "replica", "infinite", "duration",
        "tablePickCount", "dryRun", "churnRate", "churnInterval", "protocol"
      ]
    }
  },
  "required": ["replicaCount", "image", "job", "basicAuth", "sampleLoader"]
}
