{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "pullPolicy"]
    },
    "job": {
      "type": "object",
      "properties": {
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": ["integer", "null"], "minimum": 0 },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["backoffLimit", "annotations"]
    },
    "sampleLoader": {
      "type": "object",
      "properties": {
        "config": { "type": "string", "minLength": 1 },
        "remoteWriteUrl": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "interval": { "type": "string", "minLength": 1 },
        "maxSamples": { "type": "integer", "minimum": 1 },
        "tickInterval": { "type": "string", "minLength": 1 },
        "workers": { "type": "integer", "minimum": 1 },
        "replicaFromJobCompletionIndex": { "type": "boolean" },
        "replica": { "type": "integer" },
        "infinite": { "type": "boolean" },
        "tablePickCount": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
        "dryRun": { "type": "boolean" },
        "churnRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "churnInterval": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "enum": ["prometheus", "otlp"] }
      },
      "required": [
        "config", "remoteWriteUrl", "startDate", "endDate", "interval",
        "maxSamples", "tickInterval", "workers",
        "replicaFromJobCompletionIndex", "replica", "infinite",
        "tablePickCount", "dryRun", "churnRate", "churnInterval", "protocol"
      ]
    }
  },
  "required": ["replicaCount", "image", "job", "sampleLoader"]
}
